<div class="feature-grid">
<% items.forEach((item, i) => { %>
<article class="feature-card color-<%= item.color || 'teal' %>">
<% if (item.image) { %>
<div class="feature-art">
<img src="<%= item.image %>" alt="" aria-hidden="true">
</div>
<% } %>
<div class="feature-num">↳ <%= String(i + 1).padStart(2, '0') %></div>
<div class="feature-title" role="heading" aria-level="3"><%= item.title %></div>
<div class="feature-body"><%- item.description %></div>
<div class="hidden">
<span class="listing-title"><%= item.title %></span>
</div>
</article>
<% }) %>
</div>
